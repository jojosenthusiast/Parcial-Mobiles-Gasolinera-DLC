NODE_ENV=development
PORT=4000
DISPENSE_ADAPTER_MODE=manual
DATABASE_URL=postgresql://dlc:dlc_local_only@127.0.0.1:5432/dlc_dev
DATABASE_POOL_MAX=10
DATABASE_SSL_MODE=disable
# Para Supabase: verify-full y certificado CA descargado del proyecto.
DATABASE_SSL_CA_FILE=
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0
AUTH_RATE_LIMIT_KEY=local-development-key-do-not-use-in-production-0001
# Customer app uses only the Supabase Auth API; never put a service-role key here or in Flutter.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_for_qa
# Required in production for promotional image uploads. Server-only secret; never copy to Flutter or source control.
SUPABASE_SECRET_KEY=
PROMOTION_IMAGE_BUCKET=dlc-promotion-images
CUSTOMER_ORGANIZATION_ID=
CUSTOMER_TERMS_VERSION=qa-draft-v1
