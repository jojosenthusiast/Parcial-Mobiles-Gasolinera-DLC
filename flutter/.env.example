# Android Emulator local development. For a real device use a reachable QA HTTPS endpoint.
DLC_API_BASE_URL=http://10.0.2.2:4000/api/v1

# QA Supabase project values. The publishable key is public; never use a service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_for_qa
SUPABASE_AUTH_REDIRECT_URL=sv.com.dlc.dlc_customers://login-callback/
CUSTOMER_TERMS_VERSION=qa-draft-v1
